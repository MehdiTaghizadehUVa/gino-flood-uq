{$FGN_SITE_HOSTNAME} {
	tls internal
	encode gzip

	route {
		handle /oauth2/* {
			reverse_proxy oauth2-proxy:4180 {
				header_up X-Real-IP {remote_host}
				header_up X-Forwarded-Uri {uri}
			}
		}

		@public_read_api {
			method GET
			path /api/model-bundle /api/forcing-template
		}
		handle @public_read_api {
			reverse_proxy api:8000
		}

		@public_validation_api {
			method POST
			path /api/forcing/validate
		}
		handle @public_validation_api {
			reverse_proxy api:8000
		}

		handle /api/* {
			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				header_up X-Real-IP {remote_host}
				copy_headers X-Auth-Request-Email X-Auth-Request-User
				@error status 401
				handle_response @error {
					redir * /oauth2/sign_in?rd={scheme}://{host}{uri} 302
				}
			}
			reverse_proxy api:8000
		}

		@public_demo path /demo /demo/
		handle @public_demo {
			reverse_proxy frontend:3000
		}

		@public path / /_next/* /marketing/* /favicon.ico /robots.txt /sitemap.xml
		handle @public {
			reverse_proxy frontend:3000
		}

		handle {
			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				header_up X-Real-IP {remote_host}
				copy_headers X-Auth-Request-Email X-Auth-Request-User
				@error status 401
				handle_response @error {
					redir * /oauth2/sign_in?rd={scheme}://{host}{uri} 302
				}
			}
			reverse_proxy frontend:3000
		}
	}
}
