FGN_SITE_HOSTNAME=fgn.example.edu
# Production Compose pulls immutable images by default. CI sets SHA-tagged
# values during deployment; these main tags are safe defaults for manual runs.
FGN_API_IMAGE=ghcr.io/mehditaghizadehuva/gino-flood-uq/fgn-serving-python:main
FGN_WORKER_IMAGE=ghcr.io/mehditaghizadehuva/gino-flood-uq/fgn-serving-python:main
FGN_CLEANUP_IMAGE=ghcr.io/mehditaghizadehuva/gino-flood-uq/fgn-serving-python:main
FGN_FRONTEND_IMAGE=ghcr.io/mehditaghizadehuva/gino-flood-uq/fgn-serving-frontend:main
FGN_DEPLOY_COMMIT=manual
# Required: point this at the large lab-PC data disk mounted into WSL/Docker.
# Expected subdirectories: model_bundle, artifacts, backups, deployments.
FGN_DATA_ROOT=/mnt/d/FGNServing
# Postgres needs a Linux filesystem because the official image must chmod/chown
# its data directory. On WSL lab PCs, keep this on the WSL ext4 disk, while
# backups still land under FGN_DATA_ROOT/backups.
FGN_POSTGRES_DATA_ROOT=/home/jrj6wm/FGNServing/postgres
FGN_MODEL_BUNDLE_PATH=/model_bundle/coastal_fgn_bundle.json
FGN_MONITORING_BUNDLE_PATH=/model_bundle/monitoring/coastal_monitoring_bundle.json
FGN_ARTIFACT_ROOT=/artifacts
FGN_CANDIDATE_ROOT=/artifacts/retraining_candidates
FGN_MIN_FREE_GB=20
FGN_DEVICE=cuda:0
FGN_MEMBER_CHUNK_SIZE=4
FGN_INFERENCE_MODE=production
FGN_PRELOAD_MODELS=1
FGN_WORKER_STAY_ALIVE=1
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://fgn_serving:${POSTGRES_PASSWORD}@postgres:5432/fgn_serving
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
FGN_ALLOWED_EMAILS=user@example.com,admin@example.com
FGN_ADMIN_EMAILS=admin@example.com
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
OAUTH2_PROXY_COOKIE_SECRET=base64-32-byte-secret
FGN_RETENTION_DAYS=30
